# Copy the backend variables to backend/.env and the frontend ones to frontend/.env.local. Placeholders only.
# Full commented lists: backend/.env.example and frontend/.env.example.

# --- Backend ---
# Database. Production: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require (Supabase session pooler)
DATABASE_URL=sqlite+aiosqlite:///./studydungeon.db
# AI provider: mock, gemini or openrouter.
AI_PROVIDER=mock
# Gemini model name.
GEMINI_MODEL=gemini-2.0-flash
# Gemini API key (backend only).
GEMINI_API_KEY=your-gemini-api-key-here
# OpenRouter key (only for AI_PROVIDER=openrouter).
OPENROUTER_API_KEY=
OPENROUTER_ENABLED=false
# Session signing key, random and at least 32 characters in production.
SECRET_KEY=replace-with-a-very-long-random-secret-key-32-chars-minimum
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Frontend origin for CORS (the Vercel domain in production).
FRONTEND_ORIGIN=http://localhost:5173
# true behind HTTPS.
COOKIE_SECURE=false
# Trusted proxy hops for X-Forwarded-For.
TRUSTED_PROXY_COUNT=1
# Upload limits.
MAX_UPLOAD_MB=15
TEMP_UPLOAD_DIR=./temp_uploads
# Demo and guest settings.
DEMO_GUEST_TTL_HOURS=720
DEMO_RATE_LIMIT_PER_HOUR=60
# Leaderboard snapshot cache seconds.
LEADERBOARD_SNAPSHOT_SECONDS=60

# --- Frontend (Vite) ---
# true = mock mode without backend.
VITE_USE_MOCKS=true
# Backend base: http://localhost:8000 locally, /api when deployed behind the Vercel rewrite.
VITE_API_BASE=

# Mock mode (default): no backend needed.
VITE_USE_MOCKS=true

# Real backend. Set VITE_USE_MOCKS=false and one of these (VITE_API_BASE wins when both are set):
#   local backend:  VITE_API_BASE=http://localhost:8000   (backend CORS allows http://localhost:5173)
#   deployed:       VITE_API_BASE=/api                    (needs the vercel.json rewrite)
VITE_API_BASE=
# Older name, still read when VITE_API_BASE is empty.
VITE_API_BASE_URL=

# Mock only: set to true to seed 3 due reviews per room, so 3 Revenants (haunted memories) show at once.
VITE_MOCK_SEED_REVENANTS=false
# Dev + mock only: extra milliseconds on the mock demo session (try 12000) to see the
# "Waking up the dungeon..." loader and the Offline demo choice after 8 s. Ignored in production builds.
VITE_MOCK_DELAY_MS=
# Speed Reader badge needs timing data the contract does not carry yet (D19). Off by default.
VITE_BADGE_SPEED_READER=false
# Contract tests against a real backend: set VITE_API_BASE, VITE_USE_MOCKS=false, then `npm run test:contract`.

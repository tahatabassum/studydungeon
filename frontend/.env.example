VITE_API_BASE_URL=
VITE_USE_MOCKS=true
# Mock only: set to true to seed 3 due reviews per room, so 3 Revenants (haunted memories) show at once.
VITE_MOCK_SEED_REVENANTS=false
# Speed Reader badge needs timing data the contract does not carry yet (D19). Off by default.
VITE_BADGE_SPEED_READER=false
# Contract tests against a real backend: set VITE_API_BASE_URL, VITE_USE_MOCKS=false, then `npm run test:contract`.

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./studydungeon.db
# Production: DATABASE_URL=postgresql+asyncpg://user:password@host:5432/studydungeon

# AI Provider Settings
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
OPENROUTER_API_KEY=
OPENROUTER_ENABLED=false

# App Security
SECRET_KEY=replace-with-a-very-long-random-secret-key-32-chars-minimum
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_ORIGIN=http://localhost:5173

# Upload Configuration
MAX_UPLOAD_MB=15
TEMP_UPLOAD_DIR=./temp_uploads

# Demo & Guest Settings
DEMO_GUEST_TTL_HOURS=24
DEMO_RATE_LIMIT_PER_HOUR=60

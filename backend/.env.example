# Database. Local: SQLite. Production: Neon (postgres:// or postgresql:// is converted to asyncpg; add ?sslmode=require).
DATABASE_URL=sqlite+aiosqlite:///./studydungeon.db
# Production example: DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# AI provider: mock (no AI calls), gemini, or openrouter.
AI_PROVIDER=mock
# Gemini model name, required when AI_PROVIDER=gemini.
GEMINI_MODEL=gemini-2.0-flash
# Gemini API key (backend only, never in the frontend).
GEMINI_API_KEY=your-gemini-api-key-here
# OpenRouter key, only used when AI_PROVIDER=openrouter.
OPENROUTER_API_KEY=
# Manual toggle for the OpenRouter adapter.
OPENROUTER_ENABLED=false

# Session signing key. In production (COOKIE_SECURE=true) it must be random and at least 32 characters.
SECRET_KEY=replace-with-a-very-long-random-secret-key-32-chars-minimum
# Session lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# The frontend origin (the Vercel domain in production). Added to the CORS allow-list. No wildcard.
FRONTEND_ORIGIN=http://localhost:5173
# Extra CORS origins as a JSON list (optional), e.g. ["https://your-app.vercel.app"].
# CORS_ORIGINS=["http://localhost:5173"]
# Set true behind HTTPS (Render): session cookie gets Secure and the SECRET_KEY checks apply.
COOKIE_SECURE=false
# Number of trusted proxy hops for X-Forwarded-For. Use 2 for production: the Vercel rewrite plus the
# Render proxy each append one entry. Use 1 with a single proxy and 1 locally (no proxy, no header).
TRUSTED_PROXY_COUNT=2

# Max upload size in MB, enforced while the upload is read.
MAX_UPLOAD_MB=15
# Unused: uploads are processed in memory and never written to disk.
TEMP_UPLOAD_DIR=./temp_uploads
# Upload count limits, 0 = unlimited.
UPLOAD_GUEST_DAILY_LIMIT=0
UPLOAD_PLAYER_DAILY_LIMIT=0
UPLOAD_GUEST_STORED_LIMIT=0
UPLOAD_PLAYER_STORED_LIMIT=0
UPLOAD_IP_DAILY_LIMIT=0
UPLOAD_GLOBAL_DAILY_LIMIT=0

# Guest demo session lifetime in hours.
DEMO_GUEST_TTL_HOURS=720
# POST /demo/session limit per hour per IP.
DEMO_RATE_LIMIT_PER_HOUR=60
# Seconds the leaderboard table snapshot is cached.
LEADERBOARD_SNAPSHOT_SECONDS=60
